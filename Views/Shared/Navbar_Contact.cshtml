<section class="contacts-section">
    <div class="contacts-section-main">
        <div class="contacts-container">
            <div class="contacts-container-left-block">
                <div class="contacts-container-left-block-name">
                    <p>Contact</p>
                </div>
                <div class="contacts-container-left-block-info">
                    <div class="info-location info-group">
                        <img src="../assets/img/homepageImg/location.svg" alt="" />
                        <a href="#">
                            <span>
                                Head Office, Kyrgyz Republic, <br> Bishkek, A. Aidaraliyev str.60
                            </span>
                        </a>
                    </div>
                    <div class="info-email info-group">
                        <img src="../assets/img/homepageImg/emailSvg.svg" alt="" />

                        <span>
                            Email: <br />
                            <a href="#">info@reefgroup.org</a>
                        </span>
                    </div>
                    <div class="info-phone info-group">
                        <img src="../assets/img/homepageImg/phone.svg" alt="" />
                        <span>
                            Phone <br />
                                    <a href="#">
                                        +996 558 028 241 (Kyrgyzstan)
                                    </a>
                        </span>
                    </div>
                </div>
                <div class="contacts-container-left-block-empty"></div>
            </div>
            <aside class="contacts-container-right-block">
                <form action="#" method="post" class="contact-form">
                    <div class="form-row">
                        <input type="text" name="name" placeholder="Fullname" required />
                        <input type="email"
                               name="email"
                               placeholder="Email"
                               required />
                    </div>
                    <div class="form-row">
                        <input type="tel" name="phone" placeholder="Phone" />
                        <input type="text" name="subject" placeholder="Subject" />
                    </div>
                    <div class="form-row">
                        <textarea name="message"
                                  rows="5"
                                  placeholder="Message..."
                                  required></textarea>
                    </div>
                    <div class="form-row">
                        <button type="submit"><span>Submit</span></button>
                    </div>
                </form>
            </aside>
        </div>
    </div>
</section>
        </div>
    </section>